[
    {"caption": "MarkdownGlance: Open Preview to the Side", "command": "mdglance_open_side_by_side"},
    {"caption": "MarkdownGlance: Toggle Preview", "command": "mdglance_toggle_full_screen"},
    {"caption": "MarkdownGlance: Toggle Outline", "command": "mdglance_toggle_outline"},
    {"caption": "MarkdownGlance: Zoom In", "command": "mdglance_zoom", "args": {"delta": 0.1}},
    {"caption": "MarkdownGlance: Zoom Out", "command": "mdglance_zoom", "args": {"delta": -0.1}},
    {"caption": "MarkdownGlance: Reset Zoom", "command": "mdglance_zoom", "args": {"reset": true}},
    {"caption": "MarkdownGlance: Open in Browser", "command": "mdglance_open_in_browser"},
    {
        "caption": "Preferences: MarkdownGlance Settings",
        "command": "edit_settings",
        "args": {
            "base_file": "${packages}/MarkdownGlance/MarkdownGlance.sublime-settings",
            "default": "{\n\t$0\n}\n"
        }
    },
    {"caption": "MarkdownGlance: Copy Diagnostics", "command": "mdglance_copy_diagnostics"},
    {
        "caption": "Preferences: MarkdownGlance Key Bindings",
        "command": "edit_settings",
        "args": {
            "base_file": "${packages}/MarkdownGlance/Default (${platform}).sublime-keymap",
            "default": "[\n\t$0\n]\n"
        }
    }
]
