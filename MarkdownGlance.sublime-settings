{
    // Delay after the latest edit before a render begins.
    "update_delay_ms": 100,

    // Mermaid is opt-in because diagram source is sent to mermaid_server.
    "enable_mermaid": false,
    "mermaid_server": "https://mermaid.ink",

    // LaTeX math ($...$ and $$...$$) is opt-in for the same reason: formula
    // source is sent to math_server, which typesets it as an image. Off, a
    // formula is shown as its source.
    "enable_math": false,
    "math_server": "https://latex.codecogs.com",

    // HTTP images and HTTPS-to-HTTP redirects are blocked by default.
    "allow_insecure_remote_images": false,
    "remote_timeout_seconds": 15.0,
    "remote_max_bytes": 10485760,
    "remote_max_dimension": 4096,

    // minihtml cannot lay out tables, so they are typeset as monospace
    // columns that fill the measured width of the preview. This is only an
    // upper bound, for keeping tables readable on a very wide screen.
    "table_max_columns": 200,

    // The TOC beside the preview is opt-in: it takes a group of its own.
    // Closing its tab hides it for that preview only, until it is reopened.
    "enable_toc": false,

    // With it on, a TOC is shown only when both thresholds are met.
    "toc_minimum_length": 1200,
    "toc_minimum_headings": 3,

    // The table of contents and the outline take only the width their longest
    // heading needs, rather than a fixed share of the window, so that the rest
    // goes to the content. Dragging the divider yourself turns it off for that
    // group. Set to false to give them the fixed share always.
    "auto_width": true,

    // Diagnostics still redact document text and Mermaid URLs when enabled.
    "debug_logging": false
}
